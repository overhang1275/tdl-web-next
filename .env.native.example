APP_ENV=production
APP_ROOT=/opt/tld-web
APP_HOST=127.0.0.1
# --lan exposes the frontend only to this subnet; API remains on loopback.
APP_ALLOWED_SUBNET=192.168.100.0/24
APP_PORT=8080
API_PORT=8000
APP_USER=tld-web
INSTALL_REDIS=1
# Informational only; does not configure a tunnel or change AUTH_URL.
PUBLIC_URL=
# This is the TDL origin, not the Authentik origin.
AUTH_URL=http://localhost:8080
# Optional: Authentik runs outside this LXC when enabled. Use the issuer exactly as returned by discovery.
AUTHENTIK_ENABLED=false
# Optional external provider, ignored while disabled.
AUTHENTIK_ISSUER=https://identity.example.test/application/o/tdl-console/
AUTHENTIK_CLIENT_ID=replace-with-external-client-id
AUTHENTIK_CLIENT_SECRET=replace-with-external-client-secret
AUTHENTIK_ADMIN_GROUP=tdl-admin
# Canonical /etc/tld-web/tld-web.env: 0600 root:root, loaded by systemd.
# These three independent secrets are generated once and preserved on updates.
AUTH_SECRET=replace-with-generated-session-secret
TDL_POSTGRES_PASSWORD=replace-with-generated-hex-password
TDL_POSTGRES_ADMIN_PASSWORD=replace-with-distinct-maintenance-password
DATA_DIR=/opt/tld-web/data
TDL_SESSIONS_DIR=/opt/tld-web/data/sessions
EXPORTS_DIR=/opt/tld-web/data/exports
DOWNLOADS_DIR=/opt/tld-web/data/downloads
LOGS_DIR=/opt/tld-web/logs
TMP_DIR=/opt/tld-web/tmp
BACKUPS_DIR=/opt/tld-web/backups
# Generated role/database use tdl_<installation UUID without hyphens>; never adopt legacy SQLite.
DATABASE_URL=postgresql+psycopg://tdl_generateduuid:replace-with-generated-hex-password@127.0.0.1:5432/tdl_generateduuid
REDIS_URL=redis://127.0.0.1:6379/0
API_INTERNAL_URL=http://127.0.0.1:8000
TRUSTED_HOSTS=127.0.0.1,localhost

# Generated once per installation; preserve on updates. --fresh assigns a new UUID.
# INSTALLATION_ID is generated and persisted alongside the queue.
RQ_QUEUE_NAME=tdl-replace-with-installation-uuid-downloads
JWT_PRIVATE_KEY_FILE=/opt/tld-web/data/keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/opt/tld-web/data/keys/jwt-public.pem
# Both key files: 0600 API UID, in the canonical DATA_DIR/keys directory.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=/etc/tld-web/admin-password
# Password file: 0600 root, generated for noninteractive/--yes installation; forced change at login.
# --admin-password-file supplies an existing private file; no password argument is accepted.
