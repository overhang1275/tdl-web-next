APP_ENV=production
APP_ROOT=/opt/tld-web
APP_HOST=127.0.0.1
# --lan exposes the frontend only to this subnet; API remains on loopback.
APP_ALLOWED_SUBNET=192.168.100.0/24
APP_PORT=8080
API_PORT=8000
APP_USER=tld-web
INSTALL_REDIS=1
# Informational only; does not configure a tunnel or change AUTH_URL.
PUBLIC_URL=
# This is the TDL origin, not the Authentik origin.
AUTH_URL=http://localhost:8080
# Authentik must run outside this LXC. Use the issuer exactly as returned by discovery.
AUTHENTIK_ISSUER=https://identity.example.test/application/o/tdl-console/
AUTHENTIK_CLIENT_ID=replace-with-external-client-id
AUTHENTIK_CLIENT_SECRET=replace-with-external-client-secret
AUTHENTIK_ADMIN_GROUP=tdl-admin
# AUTH_SECRET is generated by the installer and preserved on updates.
DATA_DIR=/opt/tld-web/data
TDL_SESSIONS_DIR=/opt/tld-web/data/sessions
EXPORTS_DIR=/opt/tld-web/data/exports
DOWNLOADS_DIR=/opt/tld-web/data/downloads
LOGS_DIR=/opt/tld-web/logs
TMP_DIR=/opt/tld-web/tmp
BACKUPS_DIR=/opt/tld-web/backups
DATABASE_URL=sqlite:////opt/tld-web/data/telegram_downloader.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
API_INTERNAL_URL=http://127.0.0.1:8000
TRUSTED_HOSTS=127.0.0.1,localhost
