FROM python:3.12-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/data
ARG APP_UID=10001
ARG APP_GID=10001
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wipe bash curl \
    && curl --fail --silent --show-error https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/keyrings/postgresql.asc \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/* \
    && (getent group "$APP_GID" || groupadd -g "$APP_GID" app) \
    && useradd -m -u "$APP_UID" -g "$APP_GID" app \
    && mkdir /data && chown "$APP_UID:$APP_GID" /data
WORKDIR /app/backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=app backend/alembic.ini .
COPY --chown=app backend/migrations ./migrations
COPY --chown=app scripts/data-admin.py scripts/configure-env.py /app/scripts/
USER app
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

FROM base AS tests
ENV APP_ENV=test RUFF_CACHE_DIR=/tmp/ruff-cache PYTEST_ADDOPTS="-o cache_dir=/tmp/pytest-cache"
USER root
COPY backend/requirements-dev.txt .
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY --chown=app backend/app ./app
COPY --chown=app backend/tests ./tests
COPY --chown=app backend/pyproject.toml .
COPY --chown=app scripts /app/scripts
COPY --chown=app deploy /app/deploy
COPY --chown=app install-tld.sh /app/install-tld.sh
RUN chmod +x /app/scripts/fake-tdl.sh
USER app
HEALTHCHECK NONE
CMD ["bash", "-c", "ruff check app tests && pytest --tb=short"]

FROM ghcr.io/iyear/tdl:0.20.4 AS tdl
FROM base AS runtime
COPY --chown=app backend/app ./app
COPY --from=tdl /usr/bin/tdl /usr/local/bin/tdl
RUN tdl version
