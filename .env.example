# scripts/configure-env.py generates real secrets. Never commit .env.
APP_VERSION=local
DOMAIN=example.test
AUTH_URL=https://example.test
AUTH_SECRET=replace-with-random-hex-secret
AUTHENTIK_ENABLED=false
# Optional external provider, ignored while disabled.
AUTHENTIK_ISSUER=https://auth.example.test/application/o/tdl-console/
AUTHENTIK_CLIENT_ID=tdl-console
AUTHENTIK_CLIENT_SECRET=replace-with-random-client-secret
AUTHENTIK_JWKS_URL=https://auth.example.test/application/o/tdl-console/jwks/
AUTHENTIK_SECRET_KEY=replace-with-random-authentik-secret
AUTHENTIK_BOOTSTRAP_PASSWORD=replace-with-random-admin-password
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.test
# Hex credentials avoid URL escaping; this database is separate from Authentik.
TDL_POSTGRES_PASSWORD=replace-with-generated-hex-password
TDL_POSTGRES_ADMIN_PASSWORD=replace-with-distinct-maintenance-password
# Optional hosted overlay only; never reuse its database/volume for TDL.
PG_PASS=replace-with-distinct-authentik-postgres-password
TLS_DIR=/etc/telegram-downloader/certs
DATA_DIR=/opt/tld-web/data
TDL_SESSIONS_DIR=/opt/tld-web/data/sessions
EXPORTS_DIR=/opt/tld-web/data/exports
DOWNLOADS_DIR=/opt/tld-web/data/downloads
# Optional colon-separated persistent volume roots allowed for web relocation in Docker.
DOWNLOADS_ALLOWED_ROOTS=
LOGS_DIR=/opt/tld-web/data/logs
DATABASE_URL=postgresql+psycopg://tdl:replace-with-generated-hex-password@tdl-postgres:5432/tdl
APP_UID=10001
APP_GID=10001
TDL_NAMESPACE=default
COMMAND_TIMEOUT_SECONDS=7200
DOWNLOAD_BATCH_SIZE=100
DOWNLOAD_IDLE_TIMEOUT_SECONDS=600
EXPORT_BATCH_SIZE=5000

# Generated once per installation; preserve on updates. --fresh assigns a new UUID.
# INSTALLATION_ID and COMPOSE_PROJECT_NAME are generated; each --fresh uses new volumes.
RQ_QUEUE_NAME=tdl-replace-with-installation-uuid-downloads
JWT_PRIVATE_KEY_FILE=/opt/tld-web/keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/opt/tld-web/keys/jwt-public.pem
# Root-owned0600 regular file consumed only by the bootstrap CLI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=/etc/telegram-downloader/admin-password
# Generated password file: 0600 root; query with sudo cat -- PATH, then change at login.
# Private key:0600 APP_UID; public key readable by APP_UID. API/worker only.
# Basic Compose terminates TLS at nginx; native tunnel ingress needs no extra proxy.
